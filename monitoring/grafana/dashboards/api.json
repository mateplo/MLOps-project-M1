{
  "title": "Adult Income API",
  "uid": "adult-income-api",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Predictions / s", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(rate(predictions_total[1m]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"decimals": 2}}},
    {"id": 2, "type": "stat", "title": "Share predicted >50K (5m)", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(increase(predictions_total{label=\">50K\"}[5m])) / sum(increase(predictions_total[5m]))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.35}, {"color": "red", "value": 0.5}]}}}},
    {"id": 3, "type": "stat", "title": "p95 latency", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "histogram_quantile(0.95, sum(rate(prediction_latency_seconds_bucket[5m])) by (le))", "refId": "A"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 3}}},
    {"id": 4, "type": "stat", "title": "Model version serving", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(predictions_total) by (model_version)", "legendFormat": "v{{model_version}}", "refId": "A"}],
     "options": {"textMode": "name"}},
    {"id": 5, "type": "timeseries", "title": "Predictions by label", "gridPos": {"x": 0, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(rate(predictions_total[1m])) by (label)", "legendFormat": "{{label}}", "refId": "A"}]},
    {"id": 6, "type": "timeseries", "title": "Mean predicted score", "gridPos": {"x": 12, "y": 5, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "rate(prediction_score_sum[5m]) / rate(prediction_score_count[5m])", "legendFormat": "mean score", "refId": "A"}],
     "fieldConfig": {"defaults": {"min": 0, "max": 1}}},
    {"id": 7, "type": "heatmap", "title": "Score distribution", "gridPos": {"x": 0, "y": 13, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"expr": "sum(increase(prediction_score_bucket[1m])) by (le)", "format": "heatmap", "legendFormat": "{{le}}", "refId": "A"}],
     "options": {"calculate": false, "yAxis": {"unit": "short"}}}
  ]
}
